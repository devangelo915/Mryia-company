# MongoDB connection string (required for the admin dashboard and content storage)
MONGODB_URI=""

# Optional: database name (defaults to "mryia")
MONGODB_DB_NAME="mryia"

# Initial admin password (used once to seed the admin account on first deploy;
# change it afterwards from the dashboard's account section)
ADMIN_PASSWORD=""

# Optional: admin email (defaults to admin@mraya-konda.com)
ADMIN_EMAIL="admin@mraya-konda.com"

# Optional: session signing secret (derived from MONGODB_URI when unset)
SESSION_SECRET=""
